[application]

config/name="JuniperDevJameGam"
run/main_scene="uid://b4q33k7k55iyx"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SignalBus="*res://globals/signal_bus.gd"
InfoManager="*res://globals/info_manager.gd"

[display]

